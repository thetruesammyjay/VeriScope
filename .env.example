APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
# Render supplies PORT automatically; do not commit a production port here.
PORT=

MODEL_NAME=distilbert
MODEL_PATH=models/production
CLASSICAL_MODEL_PATH=models/classical/model.joblib
# Optional: download the model artifact during the Render build.
MODEL_ARTIFACT_URL=
MODEL_ARTIFACT_SHA256=
# Set only for a private release asset; keep it in the deployment secret store.
MODEL_ARTIFACT_TOKEN=

MIN_ARTICLE_LENGTH=100
MAX_ARTICLE_LENGTH=20000

NEXT_PUBLIC_API_URL=http://localhost:8000
# Comma-separated browser origins allowed to call the Render API.
CORS_ORIGINS=http://localhost:3000

# Current-source evidence retrieval
# Leave SEARCH_PROVIDER empty until a provider adapter is configured.
SEARCH_PROVIDER=
SEARCH_ENDPOINT=
# Keep provider credentials in .env or a secret manager; never commit them.
SEARCH_API_KEY=
SEARCH_MAX_RESULTS=10
SEARCH_TIMEOUT_SECONDS=15
EVIDENCE_MAX_SOURCES=5
EVIDENCE_MAX_CLAIMS=5
EVIDENCE_RECENCY_DAYS=30
